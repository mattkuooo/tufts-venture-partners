# Copy to .env.local for local development, and set the same value in the
# Vercel project settings for preview + production.

# Public access key for the "Partner With Us" form (components/sections/partner-form.tsx).
# Create a form at https://web3forms.com and paste its access key here.
#
# NOTE: NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time.
# Changing this in Vercel does nothing until you redeploy.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
