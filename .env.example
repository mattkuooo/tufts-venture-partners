# Copy to .env.local if you need to override a default. Nothing here is
# required — the site builds and runs with no .env.local at all.

# Optional. Points the "Partner With Us" form at a different Web3Forms form
# (components/sections/partner-form.tsx). The live club form's key is the
# hardcoded default, so leave this unset unless you are testing against your
# own form — create one at https://web3forms.com.
#
# This is a public key: Web3Forms documents it as safe in client-side code, and
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so a
# change here needs a rebuild before it takes effect.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
